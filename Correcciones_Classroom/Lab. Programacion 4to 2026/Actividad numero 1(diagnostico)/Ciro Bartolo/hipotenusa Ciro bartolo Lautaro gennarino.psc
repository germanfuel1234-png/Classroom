//inicio del algoritmo 
proceso rectangulo
	Definir hipotenusa, a, ancho, largo Como Real
	//define el ancho de la hipotenusa 
	escribir "Ingresa el cateto 1"
	leer ancho 
	//define el largo de la hipotenusa
	escribir "Ingresa el cateto 2"
	leer largo
	a <- (ancho * ancho) + (largo * largo)
	hipotenusa <- RC	(a) 
	
	escribir "la hipotenusa del triangulo es: ", hipotenusa
	//muestra el resultado de la hipotenusa
	//FinAlgoritmo
