Algoritmo actividad_n2
	definir numero1, numero2, numero3, promedio como real 
	escribir "ingresa el primer numero"
	leer numero1 
	escribir "ingrese el segundo numero"
	leer numero2
	escribir "por ultimo, ingrese el tercer numero"
	leer numero3
	promedio <- (numero1 + numero2 + numero3) /3
	escribir "el promedio de estos tres numeros es: ", promedio 
FinAlgoritmo
